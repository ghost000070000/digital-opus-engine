{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://digitalopus.local/schemas/digital-opus-tilemap-bundle-v1.schema.json",
  "title": "Digital Opus Tilemap Bundle v1",
  "type": "object",
  "required": ["content", "format", "integrity", "rootKind", "version"],
  "properties": {
    "format": { "const": "digital-opus-tilemap-bundle" },
    "version": { "const": 1 },
    "rootKind": { "enum": ["tilemap", "tilemap-chunk"] },
    "integrity": {
      "type": "object",
      "required": ["algorithm", "sha256"],
      "properties": {
        "algorithm": { "const": "SHA-256" },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      },
      "additionalProperties": false
    },
    "content": {
      "type": "object",
      "required": ["blobs", "dependencies", "root"],
      "properties": {
        "root": { "type": "object", "required": ["layers"] },
        "dependencies": {
          "type": "object",
          "required": ["audio", "meshAssets", "prefabs", "sortingLayers", "spriteAnimations", "spriteAssets", "textures", "tilesets"],
          "properties": {
            "audio": { "type": "array", "maxItems": 10000 },
            "meshAssets": { "type": "array", "maxItems": 10000 },
            "prefabs": { "type": "array", "maxItems": 10000 },
            "sortingLayers": { "type": "array", "maxItems": 10000 },
            "spriteAnimations": { "type": "array", "maxItems": 10000 },
            "spriteAssets": { "type": "array", "maxItems": 10000 },
            "textures": { "type": "array", "maxItems": 10000 },
            "tilesets": { "type": "array", "minItems": 1, "maxItems": 1 }
          },
          "additionalProperties": false
        },
        "blobs": {
          "type": "array",
          "maxItems": 128,
          "items": {
            "type": "object",
            "required": ["base64", "id", "mimeType", "sha256"],
            "properties": {
              "base64": { "type": "string" },
              "id": { "type": "string", "pattern": "^sha256-[0-9a-f]{64}$" },
              "mimeType": { "type": "string" },
              "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
